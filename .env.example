# Web Application Target (DVWA / Apache Server)
TARGET_WEB_URL=http://your_server_ip_or_domain/

# Remote SSH Log Tailer Credentials
REMOTE_SSH_HOST=192.168.1.100
REMOTE_SSH_PORT=22
REMOTE_SSH_USER=your_ssh_username
REMOTE_SSH_PASS=your_ssh_password
REMOTE_LOG_PATH=/var/log/apache2/access.log

# SOC Dashboard Settings
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=5000

# AI Threat Engine Runtime Config
DETECTION_THRESHOLD=0.50


